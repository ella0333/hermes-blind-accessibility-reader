{
  "manifest_version": 3,
  "name": "Blind Accessibility Video and Image Reader",
  "version": "0.5.8",
  "description": "Describes images and videos for blind and low vision people through their screen reader, using the Hermes Agent plugin, with the price read before anything is spent.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "tts",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Image and video reader settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "describe": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Describe the focused image, or start or stop narrating the playing video"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the reader settings"
    },
    "price": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Say what describing the image or narrating the video would cost"
    },
    "next": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Move to the next image or video on the page"
    }
  }
}